{
  "name": "selvedge-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing site and docs for Selvedge — selvedge.sh",
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/sync-llms.mjs --check && astro build && node scripts/update-sitemap.mjs",
    "sync:llms": "node scripts/sync-llms.mjs",
    "gen:og": "node scripts/gen-og.mjs",
    "gen:icons": "node scripts/gen-favicons.mjs",
    "preview": "npm run build && wrangler dev",
    "astro": "astro",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "check:site": "node scripts/sync-llms.mjs --check && node scripts/check-site.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "12",
    "@astrojs/starlight": "^0.35.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "astro": "^5.18.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "wrangler": "^4.105.0"
  }
}
