---
// Custom hero shown on the landing page only.
// Uses Starlight's hero data (title/tagline/actions) + adds the selvedge stripe
// + an inline install command. Wraps everything in semantic HTML so it
// matches Starlight's accessibility expectations.
//
// Route data moved from `Astro.props` to `Astro.locals.starlightRoute` in
// Starlight 0.32 — read the entry from there so the override keeps working.
const { entry } = Astro.locals.starlightRoute;
const data = entry.data.hero;
---

<section class="selvedge-hero">
  <div class="selvedge-hero__wordmark">
    <span class="selvedge-hero__stripe" aria-hidden="true"></span>
    {/* Decorative brand wordmark. The crawlable H1 is the tagline below —
        it carries the actual keywords ("Long-term memory for AI-coded
        codebases") instead of just the brand string. Both classes set
        margin: 0, so the tag swap is visually identical. */}
    <p class="selvedge-hero__title" aria-hidden="true">selvedge</p>
  </div>

  {data?.tagline && <h1 class="selvedge-hero__tag">{data.tagline}</h1>}

  <p class="selvedge-hero__sub">
    AI writes the code; the reason it chose <em>that</em> approach lives in a chat
    window that's gone by morning. Selvedge is a
    <strong>git blame for the <em>why</em></strong> — a local MCP server your agent
    (Claude Code, Cursor, Copilot) calls as it works, recording the intent behind
    each change in the moment it makes it, not reconstructing it from the diff
    afterward.
  </p>

  <code class="selvedge-hero__install" aria-label="Install command">
    pip install selvedge
  </code>

  {data?.actions && data.actions.length > 0 && (
    <div class="selvedge-hero__cta">
      {data.actions.map((a: any) => (
        <a
          href={a.link}
          class={a.variant === "primary" ? "primary" : "secondary"}
        >
          {a.text}
        </a>
      ))}
    </div>
  )}
</section>
