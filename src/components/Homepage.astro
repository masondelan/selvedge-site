---
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import { setupPrompt } from '../data/homepage.mjs';
import '../styles/homepage.css';
---
<div class="home">
  <header class="home-header">
    <a class="home-wordmark" href="/" aria-label="Selvedge home">selvedge</a>
  </header>

  <main class="home-main" data-pagefind-body>
    <h1 id="_top">Keep the why with your code.</h1>
    <p class="home-intro">Local decision memory for your coding agent.</p>

    <div class="home-action">
      <div class="home-action-row">
        <button class="home-copy" type="button" data-home-copy hidden>Copy setup prompt <span aria-hidden="true">→</span></button>
      </div>
      <p class="home-hint">Paste into your coding agent.</p>
      <p class="home-status" role="status" data-home-status></p>
      <details class="home-prompt" id="setup-prompt">
        <summary>Setup prompt</summary>
        <label for="setup-prompt-text">Read or copy this into your coding agent.</label>
        <textarea id="setup-prompt-text" readonly rows="9" spellcheck="false">{setupPrompt}</textarea>
      </details>
    </div>

  </main>

  <footer class="home-footer">
    <nav class="home-footer-links" aria-label="Explore Selvedge">
      <span id="what-gets-remembered"><span id="a-small-tool-that-stays-with-your-project"><a href="/start/what-is-selvedge/">Documentation</a></span></span>
      <a href="https://github.com/masondelan/selvedge">GitHub</a>
      <details class="home-more">
        <summary>More</summary>
        <div class="home-more-links">
          <span id="choose-your-agent"><span id="try-the-demo"><span id="find-selvedge"><a href="/start/quickstart/#install" data-home-start>CLI quickstart</a></span></span></span>
          <a href="/reference/compatibility/">Compatible agents</a>
          <a href="/compare/codebase-memory-mcp-servers/">Compare memory tools</a>
          <a href="/privacy/">Privacy</a>
        </div>
      </details>
    </nav>
    <ThemeSelect />
  </footer>
</div>

<script>
  import { track } from '../lib/launch-events';
  import { initializeCampaignPage } from '../lib/campaign-navigation.mjs';
  import { legacyDestination } from '../data/homepage.mjs';

  function followLegacyLink() {
    const destination = legacyDestination(location.hash, location.search);
    if (destination) location.replace(destination);
    return Boolean(destination);
  }
  window.addEventListener('hashchange', followLegacyLink);

  const copy = document.querySelector<HTMLButtonElement>('[data-home-copy]')!;
  const prompt = document.querySelector<HTMLDetailsElement>('#setup-prompt')!;
  const field = document.querySelector<HTMLTextAreaElement>('#setup-prompt-text')!;
  const status = document.querySelector<HTMLElement>('[data-home-status]')!;
  copy.hidden = false;
  prompt.classList.add('home-prompt-enhanced');

  copy.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(field.value);
      status.textContent = 'Copied. Paste it into your coding agent.';
      void track('prompt_copy', 'none');
    } catch {
      prompt.open = true;
      field.focus();
      field.select();
      status.textContent = 'Select and copy the prompt below.';
    }
  });

  const start = document.querySelector<HTMLAnchorElement>('[data-home-start]')!;
  start.addEventListener('click', () => { void track('start_click', 'none'); });
  // Initialize before redirects; PageFrame's shared call is deduplicated per document.
  initializeCampaignPage(document, location.href, navigator.doNotTrack, track);
  followLegacyLink();
</script>
