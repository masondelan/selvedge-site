---
// Custom <head> overrides for Starlight.
//
// What this fixes / adds:
//   - Homepage og:type is set in frontmatter so Starlight replaces its default
//     instead of emitting two conflicting values.
//   - Explicit twitter:title and twitter:description (Starlight currently omits them
//     and relies on fallback; explicit is safer across crawlers).
//   - JSON-LD structured data:
//       * Organization and WebSite describe the publisher and site identity.
//       * SoftwareApplication describes the homepage's developer tool.
//       * FAQPage describes visible questions and answers. Google retired FAQ
//         rich results in May 2026; this markup makes no search-feature promise.
//     Structured data does not guarantee rankings, rich results, or AI citations.
//
// Registration:
//   In astro.config.mjs, set:
//     starlight({
//       ...
//       components: {
//         Head: './src/components/seo/Head.astro',
//       },
//     })
//   Then Starlight's <Default /> rendering is preserved — we only append to <head>.

import Default from '@astrojs/starlight/components/Head.astro';
import { product } from '../../data/product.mjs';

const SITE = 'https://selvedge.sh';
const url = Astro.url.pathname;
const isHome = url === '/' || url === '';
const isFaq = url.startsWith('/project/faq');

const ONE_LINER = product.shortDescription;

// Pull page-level metadata from Starlight's frontmatter so we can re-emit
// what we need without duplicating Starlight's own logic.
const route = (Astro.locals as any)?.starlightRoute;
const entry = route?.entry;
const data = entry?.data ?? {};
const pageTitle = data.title ?? 'selvedge';
const pageDescription =
  data.description ??
  ONE_LINER;

// Per-page JSON-LD hint (see src/content.config.ts). Pages default to
// TechArticle; setup/tutorial pages declare structuredData.type: howto.
// Pages with a visible FAQ section declare structuredData.faq — the answers
// must match the visible page text. FAQ markup is descriptive, not a ranking lever.
const structuredData = data.structuredData ?? { type: 'techarticle' };
const faqItems: { question: string; answer: string }[] = structuredData.faq ?? [];
const lastUpdated: Date | undefined = route?.lastUpdated;
const pageUrl = `${SITE}${url}`;

// --- Structured data -------------------------------------------------------

const organization = {
  '@type': 'Organization',
  '@id': `${SITE}/#org`,
  name: 'Selvedge',
  url: SITE,
  logo: `${SITE}/favicon.svg`,
  sameAs: [
    'https://github.com/masondelan/selvedge',
    'https://pypi.org/project/selvedge/',
    'https://x.com/notmason__',
  ],
};

const website = {
  '@type': 'WebSite',
  '@id': `${SITE}/#website`,
  url: SITE,
  name: 'Selvedge',
  publisher: { '@id': `${SITE}/#org` },
  inLanguage: 'en',
};

const softwareApplication = {
  '@type': 'SoftwareApplication',
  '@id': `${SITE}/#software`,
  name: 'Selvedge',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux, Windows',
  url: SITE,
  description: ONE_LINER,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  softwareRequirements: 'Python 3.10+',
  softwareVersion: product.version,
  license: 'https://opensource.org/licenses/MIT',
  downloadUrl: 'https://pypi.org/project/selvedge/',
  sameAs: [
    'https://github.com/masondelan/selvedge',
    'https://pypi.org/project/selvedge/',
    'https://smithery.ai/server/masondelan/selvedge',
    'https://glama.ai/mcp/servers/masondelan/selvedge',
    'https://mcpservers.org/servers/masondelan/selvedge',
  ],
  featureList: [
    'Records stated reasoning for changes the agent logs',
    'Entity-level attribution (DB columns, tables, env vars, deps, API routes, functions)',
    'Selvedge prior_attempts retrieves recorded attempts and outcomes',
    'Changesets group related changes across many files',
    'Full-text search over change history',
    'Exports to the Agent Trace format',
    'Local SQLite storage with no required hosted backend',
  ],
  publisher: { '@id': `${SITE}/#org` },
};

// Per-page content node. The homepage is a SoftwareApplication listing and the
// FAQ page carries FAQPage (below), so neither gets an article/howto node.
// Everything else is a TechArticle unless it opts into HowTo.
let pageNode: Record<string, unknown> | null = null;
if (!isHome && !isFaq) {
  if (structuredData.type === 'howto') {
    pageNode = {
      '@type': 'HowTo',
      '@id': `${pageUrl}#howto`,
      name: pageTitle,
      description: pageDescription,
      url: pageUrl,
      inLanguage: 'en',
      publisher: { '@id': `${SITE}/#org` },
      ...(structuredData.steps?.length
        ? {
            step: structuredData.steps.map(
              (s: { name: string; text: string; url?: string }, i: number) => ({
                '@type': 'HowToStep',
                position: i + 1,
                name: s.name,
                text: s.text,
                ...(s.url ? { url: `${SITE}${s.url}` } : {}),
              }),
            ),
          }
        : {}),
    };
  } else {
    pageNode = {
      '@type': 'TechArticle',
      '@id': `${pageUrl}#article`,
      headline: pageTitle,
      description: pageDescription,
      url: pageUrl,
      inLanguage: 'en',
      author: { '@id': `${SITE}/#org` },
      publisher: { '@id': `${SITE}/#org` },
      isPartOf: { '@id': `${SITE}/#website` },
      ...(lastUpdated ? { dateModified: lastUpdated.toISOString() } : {}),
    };
  }
}

// Frontmatter-declared FAQ (structuredData.faq) → FAQPage node. The dedicated
// /project/faq page keeps its hand-synced block below; this is for content
// pages that opt in and carry matching visible questions and answers.
const faqNode =
  !isFaq && faqItems.length
    ? {
        '@type': 'FAQPage',
        '@id': `${pageUrl}#faq`,
        mainEntity: faqItems.map((f) => ({
          '@type': 'Question',
          name: f.question,
          acceptedAnswer: { '@type': 'Answer', text: f.answer },
        })),
      }
    : null;

// Breadcrumb trail (Home > this page). The sidebar groups (start, compare, …)
// are not real pages, so the trail stays two levels — both indexable URLs —
// rather than linking crumbs to URLs that 404.
const breadcrumbNode = isHome
  ? null
  : {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
        { '@type': 'ListItem', position: 2, name: pageTitle, item: pageUrl },
      ],
    };

// Build a graph so all entities share IDs and Google can connect them.
const graph: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@graph': isHome
    ? [organization, website, softwareApplication]
    : [
        organization,
        website,
        ...(pageNode ? [pageNode] : []),
        ...(breadcrumbNode ? [breadcrumbNode] : []),
        ...(faqNode ? [faqNode] : []),
      ],
};
---

<Default><slot /></Default>

{/* Explicit Twitter fields (better than relying on og:* fallback) */}
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:creator" content="@notmason__" />

{/* Sitewide JSON-LD graph */}
<script
  type="application/ld+json"
  set:html={JSON.stringify(graph)}
/>

{/* FAQPage schema is rendered into HTML and must match the visible FAQ page. */}
{isFaq && (
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      // Synced to src/content/docs/project/faq.md on 2026-09-12.
      // Keep this descriptive markup in sync with the visible answer text.
      mainEntity: [
        {
          '@type': 'Question',
          name: "What's the one-line description?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Selvedge is a local MCP server and CLI for recording code decisions, stated reasoning, and rejected approaches so they can be retrieved in later sessions.",
          },
        },
        {
          '@type': 'Question',
          name: 'Is it open source?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Yes. MIT-licensed. Source: github.com/masondelan/selvedge.",
          },
        },
        {
          '@type': 'Question',
          name: 'Where does my data live?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: "In a SQLite file under .selvedge/selvedge.db next to your code, or ~/.selvedge/selvedge.db when no project database is found. Run selvedge init to create a project database. Local history queries do not require a hosted backend. An MCP client may send retrieved records to its model provider. Sharing or publishing the database shares its contents, so private records need a private destination. Selvedge also has an optional usage heartbeat, off by default, and a PyPI version check. These requests do not include code, entity paths, diffs, or reasoning. SELVEDGE_TELEMETRY=0 disables the heartbeat.",
          },
        },
        {
          '@type': 'Question',
          name: 'Can I commit .selvedge/ to git?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Only if everyone with repository access should see its recorded contents. For public repositories, that means the records become public. Keep private reasoning in a private database. Back up the database consistently before sharing it, and plan how collaborators will reconcile changes. A SQLite file in git is not automatic multi-writer history synchronization.",
          },
        },
        {
          '@type': 'Question',
          name: "What if I'm using a different AI tool?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Selvedge exposes standard MCP tools and a CLI. The setup wizard supports Claude Code, Cursor, Copilot, Codex, Gemini CLI, and Windsurf; see the editor-specific setup guides for configuration and instruction files. Other MCP clients can be configured manually. Without MCP, an agent or human with shell access can record and retrieve decisions through the CLI. Native lifecycle adapters exist for all six setup targets; capabilities and activation differ. Copilot hooks target VS Code Local. Windsurf provides edit and command checks without startup or compaction hooks.",
          },
        },
        // The repeated-mistake answer remains visible on the FAQ page and links
        // to the fuller guide; this descriptive schema includes only a subset
        // of the visible questions.
        {
          '@type': 'Question',
          name: 'Why MCP instead of a plain CLI hook?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: "MCP lets a compatible agent discover and call Selvedge tools while it works. The CLI exposes the same local read and write operations, so either route can support recording a decision and querying it before a later edit. Use the interface available in your agent environment.",
          },
        },
        {
          '@type': 'Question',
          name: 'Does the agent really call log_change reliably?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Verify it in your workflow. selvedge stats reports observed tool calls, per-agent logging counts, and reasoning-quality signals. The logging ratio is a share of recorded tool calls; it does not measure every edit in the repository. Inspect a later-session retrieval and the actual changes when evaluating coverage.",
          },
        },
        {
          '@type': 'Question',
          name: 'What\'s "reasoning quality validation"?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: "log_change runs incoming reasoning through a regex-and-length validator. It catches: Empty reasoning Reasoning under 20 characters Generic placeholders: \"user request\", \"as requested\", \"per request\", \"done\", \"n/a\", \"none\", \"todo\", \"see diff\"/\"see code\"/\"see pr\", \"fix\"/\"fixed\", \"add\"/\"added\", \"remove\"/\"removed\", \"update\"/\"updated\", \"change\"/\"changed\" Failed reasoning still gets logged (warnings are advisory) but appears in the default selvedge stats output as a low-quality-reasoning count. The point is to surface the agent silently shipping low-quality logs so you can fix the prompt.",
          },
        },
        {
          '@type': 'Question',
          name: 'Why no LLM in core?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Selvedge uses deterministic rules for history queries and reasoning-quality checks. An LLM call would add a network dependency and a different reliability and cost model. The package has runtime dependencies, including the MCP SDK, Click, and Rich; the optional semantic extra adds a local embeddings model. No LLM is required by the core.",
          },
        },
        {
          '@type': 'Question',
          name: 'Will my old database keep working when I upgrade?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Yes. Selvedge has a versioned migration system since v0.3.1, and every migration is recorded in a schema_migrations table. Pre-v0.3.1 databases are bootstrapped without re-running DDL that would error. If you're on v0.2.x and an upgrade misbehaves, run selvedge doctor — it'll tell you exactly which migration step is failing.",
          },
        },
        {
          '@type': 'Question',
          name: 'Why "selvedge"?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: "The selvedge is the finished, self-bound edge of a roll of fabric — woven during the fabric's creation and visible afterwards as the dense, color-banded edge that doesn't fray. The brand pairs that with a thin red stripe in tribute to the red selvedge thread on classic Japanese denim. The product analogy is direct: capture the edge of the change as it's being made, and it survives long after the diff has been incorporated and forgotten. Like the selvedge, the why is woven in at creation time — not stitched on later.",
          },
        },
      ],
    })}
  />
)}
