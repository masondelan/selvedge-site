---
import Terminal from './Terminal.astro';
import { agents } from '../data/product.mjs';
---
<div class="agent-setup" data-agent-setup id="choose-your-agent">
  <div class="agent-picker">
    <label for="setup-agent">Your coding agent</label>
    <select id="setup-agent" data-agent-select>
      <option value="">Choose your agent…</option>
      {agents.map(agent => <option value={agent.id}>{agent.label}</option>)}
    </select>
  </div>
  <p class="setup-prerequisite">Requires Selvedge. <a href="#install">Install →</a></p>
  {agents.map((agent) => (
    <section data-agent-panel={agent.id} hidden aria-label={agent.label + ' setup'}>
      <Terminal title={"~/your-project — " + agent.label + " setup"} command={"selvedge setup --agent " + agent.id} copy kind="setup" />
      <p><strong>Restart {agent.label}</strong> in this project. Enable Selvedge’s tools if prompted.</p>
      <a class="setup-doc-link" href={agent.doc} data-launch-event="agent_docs">Full {agent.label} instructions →</a>
      <details class="setup-note"><summary>What setup changes</summary><p>{agent.note} Setup asks before changes and backs up modified files.</p></details>
      <details class="setup-note" data-measured-install>
        <summary>Help us measure installs (optional)</summary>
        <p>This optional command repeats installation or upgrade, then sends Selvedge one confirmation after it succeeds. It shares only your selected agent and campaign labels, using a one-use code that expires after seven days. No project data is sent and ongoing product telemetry stays off. <a href="/privacy/">Privacy details.</a></p>
        <p>For bash or zsh, with curl installed. The regular command above works without this confirmation.</p>
        <button type="button" class="setup-feedback" data-prepare-install={agent.id}>Prepare optional command</button>
        <p aria-live="polite" data-install-status></p>
        <div data-measured-command hidden>
          <Terminal title="optional install confirmation" command="Preparing optional installation command…" />
          <button type="button" class="setup-feedback" data-copy="" data-copy-kind="setup">Copy optional command</button>
        </div>
      </details>

    </section>
  ))}
  <noscript><p>JavaScript is off. Use your agent’s setup guide:</p><ul>{agents.map(agent => <li><a href={agent.doc}>{agent.label}</a></li>)}</ul></noscript>
</div>
<script>
  import { track, getCampaign, getCreative } from '../lib/launch-events';
  import { measuredCommand } from '../lib/measurement.mjs';
  const root = document.querySelector<HTMLElement>('[data-agent-setup]');
  if (root) {
    const picker = root.querySelector<HTMLSelectElement>('[data-agent-select]')!;
    const agentIds = Array.from(picker.options).map(option => option.value).filter(Boolean);
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-agent-panel]'));
    function selectAgent(id: string, record = false) {
      if (id && !agentIds.includes(id)) return;
      picker.value = id;
      panels.forEach(panel => { panel.hidden = panel.dataset.agentPanel !== id; });
      root!.dataset.selectedAgent = id || 'none';
      if (record && id) track('agent_select', id);
    }
    picker.addEventListener('change', () => selectAgent(picker.value, true));
    const requestedAgent = new URLSearchParams(location.search).get('agent') || '';
    selectAgent(requestedAgent);
    root.querySelectorAll<HTMLButtonElement>('[data-prepare-install]').forEach(button => button.addEventListener('click', async () => {
      const details = button.closest<HTMLElement>('[data-measured-install]')!;
      const status = details.querySelector<HTMLElement>('[data-install-status]')!;
      if (navigator.doNotTrack === '1') {
        status.textContent = 'Do Not Track is enabled. Please use the regular setup command above.';
        return;
      }
      button.disabled = true;
      try {
        const response = await fetch('/api/install-receipt', {
          method: 'POST', credentials: 'omit', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ consent: true, agent: button.dataset.prepareInstall, campaign: getCampaign(), creative: getCreative() }),
        });
        if (!response.ok) throw new Error('Receipt unavailable');
        const { token } = await response.json();
        const command = measuredCommand(button.dataset.prepareInstall!, token);
        details.querySelector<HTMLElement>('[data-measured-command] .ec-line .code')!.textContent = command;
        details.querySelector<HTMLButtonElement>('[data-measured-command] .copy button')!.dataset.code = command.replaceAll('\n', '\u007f');
        details.querySelector<HTMLButtonElement>('[data-copy]')!.dataset.copy = command;
        details.querySelector<HTMLElement>('[data-measured-command]')!.hidden = false;
        button.hidden = true;
        status.textContent = 'Review and copy the command below. Running it sends the optional confirmation; preparing it does not count as an install.';
      } catch {
        status.textContent = 'Confirmation is unavailable. Use the regular setup command above, or try again.';
        button.disabled = false;
      }
    }));
    document.querySelectorAll<HTMLButtonElement>('[data-copy], [data-copy-command] .copy button').forEach(button => button.addEventListener('click', async (event) => {
      const terminal = button.closest<HTMLElement>('[data-copy-command]');
      // Keep the shared renderer's button while retaining success-only copy metrics.
      if (terminal) event.stopImmediatePropagation();
      const originalLabel = button.getAttribute('title') || 'Copy to clipboard';
      const status = button.closest('.terminal-window')?.querySelector<HTMLElement>('[data-copy-status]')
        ?? button.closest('[data-measured-install]')?.querySelector<HTMLElement>('[data-install-status]');
      try {
        await navigator.clipboard.writeText(terminal?.dataset.copyCommand ?? button.dataset.copy ?? '');
        if (terminal) {
          button.setAttribute('title', 'Copied to clipboard');
          button.setAttribute('aria-label', 'Copied to clipboard');
          setTimeout(() => {
            button.setAttribute('title', originalLabel);
            button.removeAttribute('aria-label');
          }, 1500);
        } else button.textContent = 'Copied';
        if (status) {
          if (status.hasAttribute('data-copy-status')) status.classList.add('sr-only');
          status.textContent = 'Copied to clipboard.';
        }
        const kind = terminal?.dataset.copyKind ?? button.dataset.copyKind;
        track(kind === 'setup' ? 'setup_copy' : kind === 'prompt' ? 'prompt_copy' : 'install_copy', root.dataset.selectedAgent || 'none');
      } catch {
        if (!terminal) button.textContent = 'Copy';
        if (status) {
          status.classList.remove('sr-only');
          status.textContent = 'Copy unavailable. Select and copy the text above.';
        }
      }
    }, true));
    document.querySelector<HTMLButtonElement>('[data-feedback]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const status = document.querySelector<HTMLElement>('[data-feedback-status]')!;
      button.disabled = true;
      const sent = await track('activation_reported', root.dataset.selectedAgent || 'none');
      status.textContent = sent ? 'Thank you — confirmation received.' : 'Could not send. Please try again.';
      button.disabled = sent;
    });
    document.querySelectorAll<HTMLAnchorElement>('[data-launch-event]').forEach(link => link.addEventListener('click', () => {
      track(link.dataset.launchEvent!, root.dataset.selectedAgent || 'none');
    }));
  }
</script>
