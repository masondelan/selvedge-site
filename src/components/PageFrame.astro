---
import Default from '@astrojs/starlight/components/PageFrame.astro';
import Homepage from './Homepage.astro';
import '../styles/docs.css';
import '../styles/quickstart.css';
const isHome = Astro.url.pathname === '/';
---
{isHome ? <Homepage /> : (
  <div class:list={["docs-page", { "quickstart-page": Astro.url.pathname === "/start/quickstart/" }]}>
  <Default>
    <slot name="header" slot="header" />
    <slot name="sidebar" slot="sidebar" />
    <slot />
  </Default>
  </div>
)}
<script>
  import { initializeCampaignPage } from '../lib/campaign-navigation.mjs';
  import { track } from '../lib/launch-events';
  initializeCampaignPage(document, location.href, navigator.doNotTrack, track);
</script>
