---
import { agents } from '../data/product.mjs';
---
<table>
  <caption>MCP access is available for every listed target. The hooks column describes Selvedge’s shipped integrations; it does not inspect your installation. Review client activation and validation limits in the lifecycle guide.</caption>
  <thead><tr><th>Agent</th><th>Setup flag</th><th>MCP configuration</th><th>Instructions</th><th>Selvedge lifecycle hooks</th></tr></thead>
  <tbody>{agents.map(agent => <tr>
    <td><a href={agent.doc}>{agent.label}</a></td><td><code>{agent.id}</code></td>
    <td><code>{agent.config}</code></td><td><code>{agent.instructions}</code></td>
    <td>{agent.hooks}</td>
  </tr>)}</tbody>
</table>
